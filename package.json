{
  "name": "cv-agent-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Local, specification-driven framework that keeps a CV current, traceable and ready to send. See AGENTS.md and docs/plan.md.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "digest": "tsx scripts/digest.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "refresh": "tsx scripts/refresh.ts",
    "market": "tsx scripts/market.ts",
    "lint": "tsx scripts/lint.ts",
    "trace": "tsx scripts/trace.ts",
    "reattach-src": "tsx scripts/reattach-src.ts",
    "select": "tsx scripts/select.ts",
    "check": "tsx scripts/check.ts",
    "render": "tsx scripts/render.ts",
    "template-import": "tsx scripts/template-import.ts",
    "preview": "tsx scripts/preview.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "ajv": "^8.20.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^4.10.38",
    "yaml": "^2.9.1"
  }
}
