{
  "name": "cv-agent-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Local, specification-driven framework that keeps a CV current, traceable and ready to send. See AGENTS.md and docs/plan.md.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "digest": "tsx scripts/digest.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-reporter=dot tests/*.test.ts",
    "test:fast": "CV_FAST=1 node --import tsx --test --test-reporter=dot tests/*.test.ts",
    "test:verbose": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "refresh": "tsx scripts/refresh.ts",
    "market": "tsx scripts/market.ts",
    "lint": "tsx scripts/lint.ts",
    "trace": "tsx scripts/trace.ts",
    "reattach-src": "tsx scripts/reattach-src.ts",
    "select": "tsx scripts/select.ts",
    "check": "tsx scripts/check.ts",
    "render": "tsx scripts/render.ts",
    "template-import": "tsx scripts/template-import.ts",
    "preview": "tsx scripts/preview.ts",
    "pdf": "tsx scripts/export-pdf.ts",
    "pdf-check": "tsx scripts/pdf-check.ts",
    "build": "tsx scripts/build.ts",
    "build:all": "tsx scripts/build.ts --all",
    "status": "tsx scripts/status.ts",
    "doctor": "tsx scripts/doctor.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/backup.ts --restore",
    "git-digest": "tsx scripts/git-digest.ts",
    "harvest-prompt": "tsx scripts/harvest-prompt.ts",
    "import-summary": "tsx scripts/import-summary.ts",
    "import-doc": "tsx scripts/import-doc.ts",
    "spellcheck": "tsx scripts/spellcheck.ts",
    "portfolio": "tsx scripts/portfolio.ts",
    "portfolio-template": "tsx scripts/portfolio-template.ts",
    "build:portfolio": "tsx scripts/build-portfolio.ts",
    "index": "tsx scripts/index.ts",
    "log-application": "tsx scripts/log-application.ts",
    "review-context": "tsx scripts/review-context.ts",
    "agent-context": "tsx scripts/agent-context.ts",
    "cover-letter": "tsx scripts/cover-letter.ts",
    "impact": "tsx scripts/impact.ts",
    "doc-check": "tsx scripts/doc-check.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "ajv": "^8.20.0",
    "cspell-lib": "10.3.6",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^4.10.38",
    "yaml": "^2.9.1"
  }
}
