{
  "$id": "common.schema.json",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "tag": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "uniqueItems": true },
    "yearMonth": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/yearMonth" },
        "end": { "anyOf": [{ "$ref": "#/$defs/yearMonth" }, { "const": "present" }] }
      },
      "additionalProperties": false
    },
    "engagement": { "enum": ["full-time", "contract", "freelance"] },
    "engagementType": { "enum": ["b2b-contract", "full-time", "part-time"] }
  }
}
