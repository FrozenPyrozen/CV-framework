{
  "$id": "summary.schema.json",
  "title": "Work summary front matter (specs/work-summary-spec.md section 2)",
  "type": "object",
  "required": ["schema_version", "id", "source", "client", "role", "engagement", "period", "cv_section", "cv_client_label", "cv_location"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "source": { "enum": ["git", "cv", "user"] },
    "client": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1, "not": { "pattern": "\\(Contract\\)" } },
    "engagement": { "$ref": "common.schema.json#/$defs/engagement" },
    "period": { "$ref": "common.schema.json#/$defs/period" },
    "domain": { "type": "array", "items": { "type": "string" } },
    "team_size_led": { "type": "integer", "minimum": 0 },
    "counts_as_experience": { "type": "boolean" },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1, "not": { "pattern": "[/\\\\:@]" }, "description": "repo name only: no remote URL or local path" } },
        "additionalProperties": false
      }
    },
    "author_identities": { "type": "array", "items": { "type": "string" } },
    "harvested_at": { "anyOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
    "harvest_mode": { "enum": ["local", "portable"] },
    "show_in_cv": { "type": "boolean" },
    "cv_section": { "$ref": "common.schema.json#/$defs/id" },
    "cv_order": { "type": "integer", "minimum": 1 },
    "cv_client_label": { "type": "string", "minLength": 1 },
    "cv_location": { "type": "string", "minLength": 1 },
    "show_dates_in_cv": { "type": "boolean" },
    "cv_title_suffix": { "type": "string" },
    "cv_emphasis": { "type": "array", "items": { "type": "string" } },
    "cv_max_bullets": { "type": "integer", "minimum": 1 },
    "show_in_portfolio": { "type": "boolean", "description": "the public portfolio opts projects in (specs/outputs/portfolio.md 3); default false" },
    "portfolio_order": { "type": "integer", "minimum": 1 },
    "portfolio_title": { "type": "string", "minLength": 1, "description": "the project title in the portfolio: product plus main technologies, e.g. \"Velas crypto wallet (React, React Native, Electron)\"; default: role" },
    "portfolio_projects": { "type": "array", "minItems": 1, "description": "several portfolio pages from one job (specs/outputs/portfolio.md 3)", "items": { "type": "object", "required": ["id", "title"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
    "portfolio_label": { "type": "string", "minLength": 1, "description": "public client or product name; default cv_client_label; must hide what the CV hides" },
    "portfolio_max_items": { "type": "integer", "minimum": 1, "maximum": 20 }
  },
  "additionalProperties": false
}
