{
  "$id": "fixes.schema.json",
  "title": "templates/<name>/fixes.yaml (specs/templates.md 3)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "why", "found", "set"],
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "why": { "type": "string" },
      "found": { "type": "string" },
      "set": {
        "type": "object",
        "properties": {
          "bullet": { "type": "object", "required": ["indent_left", "hanging"], "properties": { "indent_left": { "type": "integer" }, "hanging": { "type": "integer" }, "tab": { "type": "object" } }, "additionalProperties": false },
          "keep_with_next": { "type": "array", "items": { "type": "string" } },
          "keep_sections_together": { "type": "array", "items": { "type": "string" }, "description": "section headings (as in cv_sections) kept on one page as a whole" },
          "strip_header_text": { "type": "boolean", "description": "empty every text run in the page headers (shapes stay)" },
          "date_tab": { "type": "object", "required": ["align", "pos"], "properties": { "align": { "enum": ["left", "right"] }, "pos": { "type": "integer" } }, "additionalProperties": false },
          "keep_first_bullets_together": { "type": "integer", "minimum": 2 },
          "keep_last_bullets_together": { "type": "integer", "minimum": 2 },
          "paragraphs": { "type": "object", "additionalProperties": { "type": "object", "properties": { "indent_left": { "type": "integer" }, "first_line": { "type": "integer" }, "before": { "type": "integer" }, "after": { "type": "integer" }, "line": { "type": "integer" } }, "additionalProperties": false } },
          "first_after_section_heading": { "type": "object", "required": ["before"], "properties": { "before": { "type": "integer" } }, "additionalProperties": false },
          "letter_spacing": { "type": "integer" },
          "rule_full_width": { "const": true },
          "page_margins": { "type": "object", "properties": { "top": { "type": "integer", "minimum": 0 }, "bottom": { "type": "integer", "minimum": 0 }, "left": { "type": "integer", "minimum": 0 }, "right": { "type": "integer", "minimum": 0 } }, "additionalProperties": false, "minProperties": 1 },
          "sizes": { "type": "object", "description": "portfolio templates: the page sizes they are built in (specs/outputs/portfolio.md 5)", "additionalProperties": { "type": "object", "required": ["width_twips", "height_twips"], "properties": { "width_twips": { "type": "integer", "minimum": 1 }, "height_twips": { "type": "integer", "minimum": 1 }, "page_margins": { "type": "object", "properties": { "top": { "type": "integer", "minimum": 0 }, "bottom": { "type": "integer", "minimum": 0 }, "left": { "type": "integer", "minimum": 0 }, "right": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false } }
        },
        "additionalProperties": false,
        "minProperties": 1
      }
    },
    "additionalProperties": false
  }
}
