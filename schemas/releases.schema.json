{
  "$id": "releases.schema.json",
  "description": "facts/releases.yaml: the accepted and shared CV and portfolio PDFs (specs/facts-spec.md 6), written by npm run release",
  "type": "object",
  "required": ["schema_version", "releases"],
  "properties": {
    "schema_version": { "const": 1 },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "commit", "files"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "note": { "type": "string" },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256", "source", "source_sha256"],
              "properties": {
                "path": { "type": "string", "pattern": "\\.pdf$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
                "source": { "type": "string", "pattern": "\\.md$" },
                "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
                "exporter": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
