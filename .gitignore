# macOS
.DS_Store

# Office lock/temp files
~$*
*.tmp

# Claude Code local settings
**/.claude/*.local.*

# Node
node_modules/

# Per-laptop settings and working files
framework.local.yaml
framework.local.previous.yaml
backups/
.cv-runs/

# Generated (recreated by npm run digest / build / build:all)
summaries/.digests/
cv/**/*.docx
cv/**/*.pdf
cv/**/pdf-check.md
cv/**/preview/
cv/**/selection.json
cv/.build-state.json

# Private, not in git (moved between laptops with npm run backup / restore)
cv/tailored/
cv/sent/
facts/applications.yaml

# Market versions (generated by npm run market)
cv/**/markets/


# Built portfolio (recreated by npm run build:portfolio)
portfolio/*.docx
portfolio/*.pdf
portfolio/*.pages
portfolio/pdf-check-*.md
portfolio/preview/
